{
  "name": "bn-lab-simulations",
  "version": "0.1.0",
  "description": "Open-source library of interactive physics and mathematics simulations for the web: 40 experiments and a GPU Navier-Stokes solver, with documented and validated numerical methods. No dependencies.",
  "keywords": [
    "simulation",
    "physics",
    "mathematics",
    "canvas",
    "webgl",
    "navier-stokes",
    "fluid",
    "chaos",
    "lorenz",
    "ising",
    "explorable",
    "education",
    "visualization",
    "generative"
  ],
  "homepage": "https://www.bnsolutions.cl/research/bn-lab-simulations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4mser/bn-lab-simulations.git"
  },
  "bugs": {
    "url": "https://github.com/4mser/bn-lab-simulations/issues"
  },
  "license": "MIT",
  "author": "B&N Solutions <n.moreno@bnsolutions.cl> (https://www.bnsolutions.cl)",
  "contributors": [
    "Nicolás Moreno (https://www.bnsolutions.cl/c/nico)"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/bundle.js",
    "./dist/*"
  ],
  "main": "./dist/bn-lab-simulations.mjs",
  "module": "./src/index.js",
  "unpkg": "./dist/bn-lab-simulations.min.js",
  "jsdelivr": "./dist/bn-lab-simulations.min.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./experiments": {
      "types": "./types/experiments.d.ts",
      "import": "./src/experiments/index.js"
    },
    "./experiments/*": {
      "types": "./types/experiment.d.ts",
      "import": "./src/experiments/*.js"
    },
    "./bundle": "./dist/bn-lab-simulations.mjs",
    "./style.css": "./src/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "README.es.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CITATION.cff"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/core.test.js test/experiments.test.js",
    "validate": "node validation/run.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2"
  }
}
